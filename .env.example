# -----------------------------------------------------------------------------
# ATLaS - local environment. Copy to `.env` and adjust. NEVER commit `.env`.
# -----------------------------------------------------------------------------

# Database (PostgreSQL 16+)
# RLS uses transaction-local session state, so use a real Postgres (Docker or
# managed). The `prisma dev` proxy multiplexes all clients onto one backend and
# is not supported for RLS. The runtime user must be able to SET ROLE atlas_app;
# the RLS migrations create that role and grant it.
# Docker: docker compose up -d   (Postgres 16, port 5432, volume atlas-db-data)
DATABASE_URL="postgres://postgres:postgres@localhost:5432/atlas?sslmode=disable"
# Optional: cap this process's pg pool. Defaults are 2 in dev, 10 in production
# and 1 per build worker. Keep `instances × max` below the database limit.
DATABASE_POOL_MAX=""

# Auth - 32+ char random strings. Regenerate for production.
AUTH_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"
OTP_HASH_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"

# Platform identity
NEXT_PUBLIC_APP_NAME="ATLaS"
APP_ROOT_DOMAIN="atlas.example"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storefront subdomains in local dev. `localhost` cannot resolve subdomains on
# all platforms, so the storefront is also reachable at /store/<slug>.
STOREFRONT_SUBDOMAIN_SUFFIX=".localhost:3000"

# ── Integrations (all optional; adapters fall back to sandbox/no-op) ─────────
# SMS OTP delivery. When empty, ATLaS logs the OTP in development only;
# production fails closed until a provider and credential are configured.
# There is no built-in/fallback API key.
# provider: `twilio`, `generic` (your own HTTPS endpoint) or an sms.net.bd
# compatible provider. With `twilio` set ACCOUNT_SID + AUTH_TOKEN; with
# `generic` set SMS_API_URL (and SMS_API_KEY if your gateway needs one).
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_API_URL=""
SMS_ACCOUNT_SID=""
SMS_AUTH_TOKEN=""
SMS_SENDER_ID="ATLaS"

# Email (order + subscription notifications)
# provider: `resend`, `sendgrid`, `generic`, or empty for sandbox.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_API_URL=""
EMAIL_FROM="no-reply@atlas.example"
EMAIL_FROM_NAME="ATLaS"

# Payment gateways — merchant-onboarding pending (PRD §17). Leave blank to run
# the sandbox adapters, which simulate initiate + callback flows.
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_BASE_URL="https://sandbox-ssl.mynagad.com"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""

SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# Courier integrations (Pathao / RedX / Steadfast).
# `auto` (default) uses live for a provider only when its credentials are set,
# otherwise that courier runs in sandbox mode. Use `sandbox` to force simulation
# or `live` to fail loudly when credentials are missing. The merchant's own
# courier Store ID is entered in Admin → ডেলিভারি, not here.
COURIER_MODE="auto"
# HMAC secret for POST /api/v1/webhooks/couriers/<provider>
# Header: x-atlas-signature = HMAC-SHA256(`courier:<raw body>`)
# or append ?token=<secret> for providers that cannot set headers.
# Leave blank in local dev to accept unsigned sandbox callbacks.
COURIER_WEBHOOK_SECRET=""

PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""
# Pathao order API needs numeric city/zone ids (defaults target Dhaka).
PATHAO_DEFAULT_CITY_ID="1"
PATHAO_DEFAULT_ZONE_ID="1"

REDX_BASE_URL="https://openapi.redx.com.bd"
REDX_API_TOKEN=""
# Required for live RedX orders (numeric delivery-area id).
REDX_DEFAULT_AREA_ID=""

STEADFAST_BASE_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# Product image / asset storage. `local` writes under UPLOAD_DIR; `s3` works
# with any S3-compatible endpoint (AWS, R2, MinIO). Local is fine in dev.
STORAGE_DRIVER="local"
UPLOAD_DIR="public/uploads"
# Public base for uploaded files, e.g. https://cdn.example.com (optional for local).
STORAGE_PUBLIC_BASE_URL=""
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Secret-manager reference used by PaymentMethod.encryptedSecretRef (PRD §13)
SECRETS_KEY="dev-only-32-char-secret-manager-key"

# Custom domains must CNAME to this edge/proxy host. TLS is marked ACTIVE only
# after a real HTTPS handshake against the merchant host succeeds.
DOMAIN_CNAME_TARGET="edge.atlas.example"

# Shared secret for /api/cron/* jobs (Authorization: Bearer ...).
CRON_SECRET=""

# ── Rate limiting ────────────────────────────────────────────────────────────
# The per-IP edge gate in `src/proxy.ts` is the distributed one. `memory` is
# correct for a single instance; `redis` points it at an Upstash-compatible
# REST endpoint so every instance shares one window. A failing store degrades
# to the local window instead of failing requests.
# Per-action limits inside handlers stay in-process by design.
RATE_LIMIT_DRIVER="memory"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Images ───────────────────────────────────────────────────────────────────
# Comma-separated hostnames the Next image optimizer may fetch from. Empty means
# any HTTPS host (fine for local dev and demo stores); pin this in production.
IMAGE_REMOTE_HOSTS=""

# Optional Sentry error reporting (no SDK dependency; uses the store endpoint).
SENTRY_DSN=""

# Optional audit-log forwarding (PRD §13). Every audit row is always written to
# Postgres first; when this URL is set the same event is also POSTed as JSON to
# a collector (Vector, Loki gateway, Datadog HTTP intake, ...), which can alert
# on `auth.login_failed` / `super_admin.impersonation.*` in real time.
AUDIT_LOG_WEBHOOK_URL=""
AUDIT_LOG_WEBHOOK_TOKEN=""
AUDIT_LOG_SERVICE="atlas"

# Backup drill defaults for scripts/backup.sh / restore.sh.
BACKUP_DIR="./backups"
BACKUP_RETENTION_DAYS="14"

# Tests: `npm test` is unit-only and needs no database. `npm run test:db` runs
# the service + RLS integration suite against this DATABASE_URL and creates and
# removes its own fixtures, so point it at a disposable database.
RUN_DB_TESTS=""
