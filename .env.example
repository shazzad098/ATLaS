# ─────────────────────────────────────────────────────────────────────────────
# ATLaS — local environment. Copy to `.env` and adjust. NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL 16+)
# Option A — Prisma's local Postgres, no Docker required:  npx prisma dev
#            then paste the connection string it prints.
# Option B — Docker:                                      docker compose up -d
# Option C — your own managed Postgres.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/atlas?sslmode=disable"

# Auth — 32+ char random strings. Regenerate for production.
AUTH_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"
OTP_HASH_SECRET="dev-only-change-me-0123456789abcdefghijklmnop"

# ── NestJS API (api/) — all optional, sensible defaults shown ────────────────
# The API shares DATABASE_URL and AUTH_SECRET with the web app.
API_PORT="4000"
API_ALLOWED_ORIGINS="http://localhost:3000"
# Set to ".example.com" in production so web + api share the refresh cookie.
AUTH_COOKIE_DOMAIN=""
# Login brute-force budget (per source IP + identifier).
AUTH_LOGIN_MAX_ATTEMPTS="8"
AUTH_LOGIN_WINDOW_MS="900000"
# Expose the OpenAPI UI in production (disabled by default).
API_DOCS_ENABLED=""
DATABASE_POOL_MAX="5"

# Background jobs (BullMQ + Redis). Local: `npm run redis:start`.
# Leave REDIS_URL empty or set QUEUE_ENABLED=false to run without a queue.
REDIS_URL="redis://127.0.0.1:6379"
QUEUE_PREFIX="atlas"
QUEUE_CONCURRENCY="5"
QUEUE_ENABLED="true"

# Platform identity
# Seeding creates plans, themes and the super admin only. Set to "1" to also
# load the three development demo stores — never enable this in production.
SEED_DEMO_DATA=""
NEXT_PUBLIC_APP_NAME="ATLaS"
APP_ROOT_DOMAIN="atlas.example"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Storefront subdomains in local dev. `localhost` cannot resolve subdomains on
# all platforms, so the storefront is also reachable at /store/<slug>.
STOREFRONT_SUBDOMAIN_SUFFIX=".localhost:3000"

# ── Integrations (all optional; adapters fall back to sandbox/no-op) ─────────
# SMS OTP delivery. When empty, ATLaS logs the OTP and echoes it in dev.
SMS_PROVIDER=""
SMS_API_KEY=""
SMS_API_URL=""
SMS_SENDER_ID="ATLaS"

# Email (order + subscription notifications)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_API_URL=""
EMAIL_FROM="no-reply@atlas.example"

# Payment gateways — merchant-onboarding pending (PRD §17). Leave blank to run
# the sandbox adapters, which simulate initiate + callback flows.
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""

NAGAD_BASE_URL="https://sandbox-ssl.mynagad.com"
NAGAD_MERCHANT_ID=""
NAGAD_MERCHANT_PRIVATE_KEY=""

SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""

# Third-party courier (PRD §5.1 — 0.5% payment charge where applicable)
COURIER_PROVIDER=""
COURIER_API_URL=""
COURIER_API_KEY=""
COURIER_WEBHOOK_SECRET=""

# Secret-manager reference used by PaymentMethod.encryptedSecretRef (PRD §13)
# MUST be replaced with 32+ random chars in production (boot refuses the default).
SECRETS_KEY="dev-only-32-char-secret-manager-key"

# ── Scheduler ────────────────────────────────────────────────────────────────
# Required: the billing/webhook cron endpoint authenticates with this bearer token.
#   POST /api/internal/cron/billing  (Authorization: Bearer $CRON_SECRET)
CRON_SECRET="dev-only-cron-secret-change-me"

# ── Object storage (Cloudflare R2 / AWS S3 / MinIO) ──────────────────────────
# Required in production (product image uploads). Leave empty to disable uploads.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL used to build image URLs, e.g. https://pub-xxxx.r2.dev or a CDN.
S3_PUBLIC_BASE_URL=""
# true for MinIO/path-style endpoints, false for R2/S3.
S3_FORCE_PATH_STYLE="false"

# Internal URL of the Nest API, used by the web server for server-to-server calls
# (e.g. product-image presign). Same host in production.
API_INTERNAL_URL="http://localhost:4000"

# ── Error monitoring (optional) ──────────────────────────────────────────────
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_TRACES_SAMPLE_RATE="0.1"

# ── Email (pluggable: resend | smtp; unset = sandbox log) ────────────────────
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_API_URL="https://api.resend.com"
EMAIL_FROM="no-reply@atlas.example"
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_SMTP_SECURE="false"

# ── Background worker ─────────────────────────────────────────────────────────
# false = don't run the BullMQ worker in the HTTP process (run `npm run api:worker` separately).
QUEUE_RUN_WORKER="true"

# ── Production safety ────────────────────────────────────────────────────────
# NEVER enable in production: it allows OTP codes to be echoed when SMS is unset.
ALLOW_SANDBOX_SMS=""
