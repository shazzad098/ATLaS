{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "dev:web": "next dev",
    "api:install": "npm --prefix api install",
    "api:dev": "npm --prefix api run dev",
    "api:build": "npm --prefix api run build",
    "api:start": "npm --prefix api run start",
    "api:worker": "npm --prefix api run worker",
    "api:typecheck": "npm --prefix api run typecheck",
    "api:lint": "npm --prefix api run lint",
    "api:test": "npm --prefix api test",
    "redis:start": "npm --prefix api run redis:start",
    "redis:stop": "npm --prefix api run redis:stop",
    "redis:status": "npm --prefix api run redis:status",
    "s3:start": "npm --prefix api run s3:start",
    "s3:stop": "npm --prefix api run s3:stop",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint .",
    "test": "tsx --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:start": "node scripts/ensure-db.mjs",
    "db:stop": "prisma dev stop atlas",
    "db:status": "prisma dev ls",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "nanoid": "^5",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
