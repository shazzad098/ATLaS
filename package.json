{
  "name": "atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && eslint .",
    "test": "node --import ./scripts/register-ts-paths.mjs --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:db": "node --env-file=.env.test --import ./scripts/register-ts-paths.mjs --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:e2e": "node --import ./scripts/register-ts-paths.mjs --experimental-strip-types --test \"src/e2e/**/*.test.ts\"",
    "test:coverage": "node --env-file=.env.test --import ./scripts/register-ts-paths.mjs --experimental-strip-types --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=55 --test-coverage-functions=45 --test \"src/**/*.test.ts\"",
    "audit": "npm audit --omit=dev --audit-level=high",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "integrations:check": "tsx scripts/integration-status.ts",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.8",
    "jose": "^6.2.12",
    "lucide-react": "^1.59.0",
    "nanoid": "^5",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
