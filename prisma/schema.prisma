// ATLaS — multi-tenant SaaS e-commerce platform
// Database blueprint (PRD §10). PostgreSQL.
//
// Conventions
//  - Every business table carries `tenantId` (or reaches one through its store)
//    so that server-side tenant scoping can never be skipped by a query.
//  - Money columns are fixed-precision Decimal. Floating point is never used (PRD §10.7).
//  - Financial records (orders, invoices, fee ledger) are immutable: soft delete only.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum TenantStatus {
  ACTIVE
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  DRAFT
  PUBLISHED
  SUSPENDED
}

enum ThemeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// Buyer-generated product reviews. Auto-approved by default; the status field
/// leaves room for merchant moderation without a schema change.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DomainType {
  SUBDOMAIN
  CUSTOM
}

enum DomainStatus {
  PENDING
  VERIFIED
  ACTIVE
  FAILED
  SUSPENDED
}

enum CatalogStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum InventoryMovementType {
  INITIAL
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT
  RESERVATION
  RESERVATION_RELEASE
  IMPORT
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentState {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
  RETURNED
}

enum PaymentProvider {
  COD
  BKASH
  NAGAD
  SSLCOMMERZ
  MANUAL
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  REFUNDED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  READ_ONLY
  SUSPENDED
  CANCELLED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum FeeType {
  PLATFORM_OVERAGE
  COURIER_THIRD_PARTY
  GATEWAY_PASSTHROUGH
}

enum FeeStatus {
  PENDING
  INVOICED
  VOID
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum WebhookStatus {
  PENDING
  DELIVERED
  FAILED
  DEAD
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. Identity and tenancy (PRD §10.1)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  phone           String     @unique
  email           String?    @unique
  name            String?
  passwordHash    String?
  status          UserStatus @default(PENDING)
  isSuperAdmin    Boolean    @default(false)
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  /**
   * TOTP secret, base32. Kept encrypted with `SECRETS_KEY` while at rest; the
   * plaintext only exists in memory during setup/verification (FR-01, §13).
   */
  twoFactorSecret      String?
  twoFactorEnabled     Boolean    @default(false)
  twoFactorConfirmedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  tenants          Tenant[]       @relation("TenantOwner")
  memberships      Membership[]
  sessions         Session[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  recoveryCodes    TwoFactorRecoveryCode[]
  twoFactorChallenges TwoFactorChallenge[]
  impersonations   ImpersonationSession[] @relation("ImpersonationActor")

  @@index([status, createdAt])
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  ownerUserId String
  status      TenantStatus @default(ACTIVE)
  timezone    String       @default("Asia/Dhaka")
  currency    String       @default("BDT")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  owner             User              @relation("TenantOwner", fields: [ownerUserId], references: [id])
  memberships       Membership[]
  roles             Role[]
  stores            Store[]
  subscription      Subscription?
  invoices          Invoice[]
  usageCounters     UsageCounter[]
  feeLedger         FeeLedger[]
  auditLogs         AuditLog[]
  tickets           SupportTicket[]
  webhookDeliveries WebhookDelivery[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  analyticsEvents   AnalyticsEvent[]
  exportJobs        ExportJob[]
  exportSchedules   ExportSchedule[]
  impersonations    ImpersonationSession[]

  @@index([ownerUserId])
  @@index([status])
}

model Membership {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  roleId     String
  status     MembershipStatus @default(ACTIVE)
  invitedAt  DateTime         @default(now())
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
}

model Role {
  id              String   @id @default(cuid())
  tenantId        String?
  code            String
  name            String
  permissionsJson Json     @default("[]")
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())

  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  ip               String?
  userAgent        String?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

/// OTP challenges for Bangladesh mobile verification (FR-01).
/// Codes are stored hashed and are single-use with attempt + expiry limits.
model OtpChallenge {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  purpose    String    @default("LOGIN")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, purpose, createdAt])
  @@index([expiresAt])
}

/// Short-lived second-factor challenge issued after the first factor succeeds.
/// Only the SHA-256 hash of the browser token is stored, so a database leak
/// cannot be replayed; attempts and expiry are enforced server-side.
model TwoFactorChallenge {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

/// One-time recovery codes. Hashed with an application secret and consumed
/// atomically, so a code works exactly once even under concurrent requests.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
}

/// Time-boxed Super Admin impersonation (FR-02, PRD §4.5, §13).
/// A reason and support reference are mandatory, the session expires after 60
/// minutes, and it is read-only for merchant data. Start and end both land in
/// the audit log.
model ImpersonationSession {
  id           String    @id @default(cuid())
  superAdminId String
  tenantId     String
  storeId      String?
  reason       String
  reference    String
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  endedAt      DateTime?

  superAdmin User   @relation("ImpersonationActor", fields: [superAdminId], references: [id], onDelete: Cascade)
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([superAdminId, endedAt])
  @@index([tenantId, startedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// 2. Store and theme (PRD §10.2)
// ─────────────────────────────────────────────────────────────────────────────

model Store {
  id          String      @id @default(cuid())
  tenantId    String
  name        String
  slug        String      @unique
  description String?
  logoAssetId String?
  status      StoreStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  settings           StoreSettings?
  themes             StoreTheme[]
  pages              ContentPage[]
  domains            Domain[]
  categories         Category[]
  products           Product[]
  customers          Customer[]
  carts              Cart[]
  orders             Order[]
  coupons            Coupon[]
  assets             Asset[]
  inventoryMovements InventoryMovement[]
  paymentMethods     PaymentMethod[]
  deliveryZones      DeliveryZone[]
  deliveryMethods    DeliveryMethod[]
  shipments          Shipment[]
  feeLedger          FeeLedger[]
  paymentWebhookEvents PaymentWebhookEvent[]
  notificationDeliveries NotificationDelivery[]
  analyticsEvents    AnalyticsEvent[]
  dailyMetrics       DailyStoreMetric[]
  exportJobs         ExportJob[]
  exportSchedules    ExportSchedule[]
  reviews            ProductReview[]
  wishlist           WishlistItem[]

  @@index([tenantId, status])
  @@index([status, publishedAt])
}

model StoreSettings {
  storeId           String   @id
  locale            String   @default("bn")
  addressJson       Json     @default("{}")
  contactJson       Json     @default("{}")
  seoJson           Json     @default("{}")
  checkoutJson      Json     @default("{}")
  taxJson           Json     @default("{}")
  policyJson        Json     @default("{}")
  notificationsJson Json     @default("{}")
  updatedAt         DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Theme {
  id             String      @id @default(cuid())
  code           String      @unique
  name           String
  description    String?
  previewAssetId String?
  industry       String?
  style          String?
  status         ThemeStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  versions ThemeVersion[]

  @@index([status])
}

model ThemeVersion {
  id                  String      @id @default(cuid())
  themeId             String
  version             String
  configSchemaJson    Json        @default("{}")
  compatiblePlansJson Json        @default("[]")
  assetManifestJson   Json        @default("{}")
  changelog           String?
  status              ThemeStatus @default(ACTIVE)
  createdAt           DateTime    @default(now())

  theme       Theme        @relation(fields: [themeId], references: [id], onDelete: Cascade)
  storeThemes StoreTheme[]

  @@unique([themeId, version])
  @@index([themeId, status])
}

model StoreTheme {
  id              String    @id @default(cuid())
  storeId         String
  themeVersionId  String
  configJson      Json      @default("{}")
  draftConfigJson Json      @default("{}")
  isSelected      Boolean   @default(false)
  lockedUntil     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  store        Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  themeVersion ThemeVersion @relation(fields: [themeVersionId], references: [id])

  @@unique([storeId, themeVersionId])
  @@index([storeId, isSelected])
}

model ContentPage {
  id        String        @id @default(cuid())
  storeId   String
  slug      String
  title     String
  bodyJson  Json          @default("{}")
  status    CatalogStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, slug])
}

model Domain {
  id                 String       @id @default(cuid())
  storeId            String
  host               String       @unique
  type               DomainType   @default(SUBDOMAIN)
  verificationToken  String?
  verificationStatus DomainStatus @default(PENDING)
  tlsStatus          DomainStatus @default(PENDING)
  isPrimary          Boolean      @default(false)
  verifiedAt         DateTime?
  /// Expected CNAME/A routing target shown to the merchant.
  routingTarget      String?
  dnsLastCheckedAt   DateTime?
  dnsError           String?
  /// Set only after an HTTPS handshake against the live host succeeds.
  tlsIssuedAt        DateTime?
  tlsLastCheckedAt   DateTime?
  tlsAttempts        Int          @default(0)
  tlsError           String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, type])
  @@index([verificationStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// 3. Catalog and inventory (PRD §10.3)
// ─────────────────────────────────────────────────────────────────────────────

model Category {
  id           String        @id @default(cuid())
  storeId      String
  parentId     String?
  name         String
  slug         String
  imageAssetId String?
  sortOrder    Int           @default(0)
  status       CatalogStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, status])
}

model Product {
  id                String        @id @default(cuid())
  storeId           String
  categoryId        String?
  name              String
  slug              String
  descriptionJson   Json          @default("{}")
  tags              String[]      @default([])
  lowStockThreshold Int           @default(5)
  status            CatalogStatus @default(DRAFT)
  seoJson           Json          @default("{}")
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  store      Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category   Category?        @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  images     ProductImage[]
  orderItems OrderItem[]
  reviews    ProductReview[]
  wishlist   WishlistItem[]

  @@unique([storeId, slug])
  @@index([storeId, status])
  @@index([storeId, categoryId])
  @@index([storeId, createdAt])
}

model ProductVariant {
  id               String        @id @default(cuid())
  productId        String
  sku              String
  optionValuesJson Json          @default("{}")
  price            Decimal       @db.Decimal(14, 2)
  comparePrice     Decimal?      @db.Decimal(14, 2)
  costPrice        Decimal?      @db.Decimal(14, 2)
  stockQty         Int           @default(0)
  reservedQty      Int           @default(0)
  weightGrams      Int?
  status           CatalogStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, sku])
  @@index([productId, status])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  assetId   String?
  url       String?
  sortOrder Int     @default(0)
  altText   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model InventoryMovement {
  id            String                @id @default(cuid())
  storeId       String
  variantId     String
  type          InventoryMovementType
  quantityDelta Int
  reason        String?
  referenceType String?
  referenceId   String?
  actorId       String?
  createdAt     DateTime              @default(now())

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([variantId, createdAt])
}

model Asset {
  id           String   @id @default(cuid())
  storeId      String?
  objectKey    String   @unique
  /** Public URL stored on ProductImage/theme settings; lets deletes find the object. */
  url          String?  @unique
  mimeType     String
  sizeBytes    Int
  checksum     String?
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// 4. Orders and customers (PRD §10.4)
// ─────────────────────────────────────────────────────────────────────────────

model Customer {
  id            String        @id @default(cuid())
  storeId       String
  name          String
  phone         String
  email         String?
  /// Set when the buyer created a storefront account; null for guest checkouts.
  passwordHash  String?
  lastLoginAt   DateTime?
  addressJson   Json          @default("{}")
  consentJson   Json          @default("{}")
  status        CatalogStatus @default(ACTIVE)
  isBlacklisted Boolean       @default(false)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  carts    Cart[]
  orders   Order[]
  reviews  ProductReview[]
  comments ReviewComment[]
  wishlist WishlistItem[]

  @@unique([storeId, phone])
  @@index([storeId, createdAt])
  @@index([storeId, email])
}

/// A buyer's review of one product. One review per customer per product; the
/// optional `orderId` marks it as a verified purchase.
model ProductReview {
  id         String       @id @default(cuid())
  storeId    String
  productId  String
  customerId String
  orderId    String?
  rating     Int
  title      String?
  body       String
  /// Display-name snapshot so buyers can read reviews without seeing other
  /// customers' rows (RLS hides the Customer relation from them).
  authorName String       @default("ক্রেতা")
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product  Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order    Order?         @relation(fields: [orderId], references: [id])
  comments ReviewComment[]

  @@index([customerId, productId, createdAt])
  @@index([storeId, productId, status, createdAt])
  @@index([storeId, status, createdAt])
}

/// Buyer comments on a review (threaded under `reviewId`).
model ReviewComment {
  id         String   @id @default(cuid())
  reviewId   String
  customerId String?
  authorName String
  body       String
  createdAt  DateTime @default(now())

  review   ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customer Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([reviewId, createdAt])
}

/// Saved products for a signed-in buyer.
model WishlistItem {
  id         String   @id @default(cuid())
  storeId    String
  customerId String
  productId  String
  createdAt  DateTime @default(now())

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([storeId, customerId])
}

model Cart {
  id         String     @id @default(cuid())
  storeId    String
  customerId String?
  sessionKey String
  status     CartStatus @default(OPEN)
  couponCode String?
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@unique([storeId, sessionKey])
  @@index([storeId, status])
}

model CartItem {
  id                String  @id @default(cuid())
  cartId            String
  variantId         String
  quantity          Int
  unitPriceSnapshot Decimal @db.Decimal(14, 2)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                  String            @id @default(cuid())
  storeId             String
  orderNo             String
  customerId          String?
  customerName        String
  customerPhone       String
  status              OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus       PaymentState      @default(PENDING)
  fulfillmentStatus   FulfillmentStatus @default(UNFULFILLED)
  paymentProvider     PaymentProvider   @default(COD)
  subtotal            Decimal           @db.Decimal(14, 2)
  discountTotal       Decimal           @default(0) @db.Decimal(14, 2)
  shippingTotal       Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal            Decimal           @default(0) @db.Decimal(14, 2)
  /** Rate + mode snapshot so a later settings change cannot rewrite history. */
  taxJson             Json              @default("{}")
  grandTotal          Decimal           @db.Decimal(14, 2)
  currency            String            @default("BDT")
  couponCode          String?
  addressSnapshotJson Json              @default("{}")
  notes               String?
  idempotencyKey      String?           @unique
  placedAt            DateTime          @default(now())
  confirmedAt         DateTime?
  deliveredAt         DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?

  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer  Customer?    @relation(fields: [customerId], references: [id])
  items     OrderItem[]
  events    OrderEvent[]
  payments  Payment[]
  returns   Return[]
  feeLedger FeeLedger[]
  shipments Shipment[]
  notificationDeliveries NotificationDelivery[]
  reviews   ProductReview[]

  @@unique([storeId, orderNo])
  @@index([storeId, status, createdAt])
  @@index([storeId, createdAt])
  @@index([storeId, paymentStatus])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String?
  variantId     String?
  nameSnapshot  String
  skuSnapshot   String?
  quantity      Int
  unitPrice     Decimal @db.Decimal(14, 2)
  discountTotal Decimal @default(0) @db.Decimal(14, 2)
  lineTotal     Decimal @db.Decimal(14, 2)
  refundedQty   Int     @default(0)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model OrderEvent {
  id         String   @id @default(cuid())
  orderId    String
  fromStatus String?
  toStatus   String
  actorType  String   @default("SYSTEM")
  actorId    String?
  note       String?
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Return {
  id          String       @id @default(cuid())
  orderId     String
  status      ReturnStatus @default(REQUESTED)
  reason      String?
  resolution  String?
  requestedAt DateTime     @default(now())
  resolvedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// 5. Payments, billing and fees (PRD §10.5)
// ─────────────────────────────────────────────────────────────────────────────

model PaymentMethod {
  id                 String          @id @default(cuid())
  storeId            String
  provider           PaymentProvider
  publicConfigJson   Json            @default("{}")
  encryptedSecretRef String?
  isEnabled          Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
}

model Payment {
  id             String               @id @default(cuid())
  orderId        String
  provider       PaymentProvider
  providerTxnId  String?
  amount         Decimal              @db.Decimal(14, 2)
  feeAmount      Decimal              @default(0) @db.Decimal(14, 2)
  status         PaymentAttemptStatus @default(INITIATED)
  idempotencyKey String?
  rawReference   String?
  failureReason  String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxnId])
  @@index([orderId, status])
}

model PaymentWebhookEvent {
  id             String          @id @default(cuid())
  provider       PaymentProvider
  eventKey       String
  /** Set once the callback is matched to an order, so admin queries can scope. */
  storeId        String?
  signatureValid Boolean         @default(false)
  payloadHash    String
  payloadJson    Json            @default("{}")
  processedAt    DateTime?
  status         String          @default("RECEIVED")
  error          String?
  createdAt      DateTime        @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Idempotency guard: a provider event is processed at most once (PRD §10.7).
  @@unique([provider, eventKey])
  @@index([provider, status])
  @@index([storeId, createdAt])
}

model Plan {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  billingPeriod BillingPeriod @default(MONTHLY)
  price         Decimal       @default(0) @db.Decimal(14, 2)
  yearlyPrice   Decimal?      @db.Decimal(14, 2)
  currency      String        @default("BDT")
  trialDays     Int           @default(7)
  sortOrder     Int           @default(0)
  isPublic      Boolean       @default(true)
  limitsJson    Json          @default("{}")
  featuresJson  Json          @default("{}")
  status        String        @default("ACTIVE")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                  String             @id @default(cuid())
  tenantId            String             @unique
  planId              String
  status              SubscriptionStatus @default(TRIALING)
  trialEnd            DateTime?
  billingPeriod       BillingPeriod      @default(MONTHLY)
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime?
  graceEndsAt         DateTime?
  cancelAtPeriodEnd   Boolean            @default(false)
  cancelledAt         DateTime?
  lastPaymentFailedAt DateTime?
  /** Set the first time a paid-plan trial starts; trials are one-time only. */
  trialUsedAt         DateTime?
  /** Plan change requested but not yet paid. Entitlements stay on the current plan. */
  pendingPlanCode     String?
  pendingBillingPeriod BillingPeriod?
  pendingInvoiceId    String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([status, currentPeriodEnd])
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  subscriptionId String?
  number         String        @unique
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  discount       Decimal       @default(0) @db.Decimal(14, 2)
  tax            Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  currency       String        @default("BDT")
  status         InvoiceStatus @default(OPEN)
  linesJson      Json          @default("[]")
  dueAt          DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([tenantId, status, createdAt])
}

model UsageCounter {
  id          String   @id @default(cuid())
  tenantId    String
  metric      String
  periodStart DateTime
  periodEnd   DateTime
  quantity    Int      @default(0)
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
}

model FeeLedger {
  id         String    @id @default(cuid())
  tenantId   String
  storeId    String
  orderId    String?
  feeType    FeeType
  baseAmount Decimal   @db.Decimal(14, 2)
  rate       Decimal   @db.Decimal(7, 4)
  feeAmount  Decimal   @db.Decimal(14, 2)
  currency   String    @default("BDT")
  status     FeeStatus @default(PENDING)
  invoiceId  String?
  reversedAt DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  // One ledger row per fee type per order keeps recalculation idempotent.
  @@unique([orderId, feeType])
  @@index([tenantId, status, createdAt])
  @@index([storeId, createdAt])
}

model Coupon {
  id         String        @id @default(cuid())
  storeId    String
  code       String
  type       CouponType
  value      Decimal       @db.Decimal(14, 2)
  minOrder   Decimal       @default(0) @db.Decimal(14, 2)
  usageLimit Int?
  usedCount  Int           @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  status     CatalogStatus @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId, status])
}

model DeliveryZone {
  id        String   @id @default(cuid())
  storeId   String
  name      String
  areas     Json     @default("[]")
  charge    Decimal  @default(0) @db.Decimal(14, 2)
  freeAbove Decimal? @db.Decimal(14, 2)
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
}

enum CourierProvider {
  PATHAO
  REDX
  STEADFAST
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIAL_DELIVERED
  RETURNED
  CANCELLED
  FAILED
}

// Merchant courier accounts for order delivery (FR-07). One row per store and
// courier; the merchant keeps their own store/account ID issued by the courier.
model DeliveryMethod {
  id             String          @id @default(cuid())
  storeId        String
  provider       CourierProvider
  courierStoreId String          @default("")
  isEnabled      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([storeId, isEnabled])
}

// A consignment handed to a third-party courier. One order can have several
// shipments over time (for example a failed attempt retried with another
// courier), so the active one is the newest non-terminal row.
model Shipment {
  id               String         @id @default(cuid())
  storeId          String
  orderId          String
  provider         CourierProvider
  consignmentId    String
  trackingCode     String
  status           ShipmentStatus @default(PENDING)
  isSandbox        Boolean        @default(true)
  codAmount        Decimal        @default(0) @db.Decimal(14, 2)
  recipientName    String
  recipientPhone   String
  recipientAddress String
  recipientCity    String?
  note             String?
  eventsJson       Json           @default("[]")
  lastSyncedAt     DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, consignmentId])
  @@index([storeId, status])
  @@index([orderId])
  @@index([trackingCode])
}

// ─────────────────────────────────────────────────────────────────────────────
// 6. Audit and operations (PRD §10.6)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  metadataJson Json     @default("{}")
  ip           String?
  createdAt    DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String?
  payloadJson Json      @default("{}")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

/// Customer-facing email/SMS delivery log (FR-09). Provider failures never
/// block checkout, but they must be visible to the merchant/operator.
model NotificationDelivery {
  id          String   @id @default(cuid())
  storeId     String?
  orderId     String?
  channel     String
  recipient   String
  type        String
  status      String   @default("PENDING")
  provider    String?
  error       String?
  payloadJson Json     @default("{}")
  sentAt      DateTime?
  createdAt   DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([status, createdAt])
  @@index([orderId])
}

model SupportTicket {
  id          String         @id @default(cuid())
  tenantId    String?
  requesterId String?
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  subject     String
  body        String
  assignedTo  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status, priority, createdAt])
}

model WebhookDelivery {
  id          String        @id @default(cuid())
  tenantId    String
  webhookEndpointId String?
  eventType   String
  endpoint    String
  payloadJson Json          @default("{}")
  payloadHash String
  status      WebhookStatus @default(PENDING)
  attempts    Int           @default(0)
  lastError   String?
  nextRetryAt DateTime?
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpointRef WebhookEndpoint? @relation(fields: [webhookEndpointId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, nextRetryAt])
  @@index([webhookEndpointId, createdAt])
}

/// Merchant-owned outbound webhook destination (FR-11). The signing secret is
/// shown once at creation and then only used server-side.
model WebhookEndpoint {
  id             String   @id @default(cuid())
  tenantId       String
  url            String
  secret         String
  eventsJson     Json     @default("[]")
  status         String   @default("ACTIVE")
  failureCount   Int      @default(0)
  lastDeliveryAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId, status])
}

/// Hashed, scoped API credential. The raw key is returned once on creation.
model ApiKey {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  prefix      String    @unique
  hash        String    @unique
  scopesJson  Json      @default("[]")
  createdBy   String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, revokedAt])
  @@index([hash])
}

/// Daily rollup used by the reports dashboard and retention/analytics queries.
/// Kept separate from live orders so historical reporting stays cheap even
/// after raw events age out.
model DailyStoreMetric {
  id             String   @id @default(cuid())
  storeId        String
  date           DateTime
  orders         Int      @default(0)
  paidOrders     Int      @default(0)
  deliveredOrders Int     @default(0)
  cancelledOrders Int     @default(0)
  grossPaisa     Int      @default(0)
  refundPaisa    Int      @default(0)
  taxPaisa       Int      @default(0)
  shippingPaisa  Int      @default(0)
  unitsSold      Int      @default(0)
  newCustomers   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId, date])
}

/// Queued CSV export. The worker writes the generated file into `fileContent`
/// and the admin download route streams it; this keeps request latency bounded
/// on large stores and gives every export an auditable status.
model ExportJob {
  id           String    @id @default(cuid())
  tenantId     String
  storeId      String
  type         String
  status       String    @default("PENDING")
  filtersJson  Json      @default("{}")
  requestedBy  String?
  fileContent  String?   @db.Text
  rowCount     Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([storeId, status, createdAt])
}

/// Pro-plan recurring export (daily/weekly). The cron turns each due schedule
/// into an ExportJob so failures and retries share one code path.
model ExportSchedule {
  id             String   @id @default(cuid())
  tenantId       String
  storeId        String
  type           String
  frequency      String
  recipientsJson Json     @default("[]")
  active         Boolean  @default(true)
  nextRunAt      DateTime
  lastRunAt      DateTime?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([active, nextRunAt])
  @@index([tenantId])
}

/// Product/checkout/analytics event stream (FR-09). Store-scoped and append-only.
model AnalyticsEvent {
  id          String   @id @default(cuid())
  tenantId    String?
  storeId     String?
  name        String
  path        String?
  referrer    String?
  userAgent   String?
  sessionId   String?
  metadataJson Json    @default("{}")
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store?  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, name, occurredAt])
  @@index([tenantId, occurredAt])
}
