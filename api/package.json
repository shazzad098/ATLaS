{
  "name": "@atlas/api",
  "version": "0.1.0",
  "private": true,
  "description": "ATLaS platform API (NestJS). See ../README.md for how it fits with the Next.js app.",
  "license": "UNLICENSED",
  "overrides": {
    "multer": "^2.5.0"
  },
  "scripts": {
    "postinstall": "node scripts/sync-prisma-schema.mjs",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPatterns \"src/\"",
    "test:e2e": "jest --runInBand --testPathPatterns \"test/\"",
    "db:sync": "node scripts/sync-prisma-schema.mjs",
    "db:generate": "npm run db:sync && prisma generate",
    "db:migrate": "npm run db:sync && prisma migrate deploy",
    "db:status": "npm run db:sync && prisma migrate status",
    "db:studio": "npm run db:sync && prisma studio",
    "redis:start": "node scripts/local-redis.mjs start",
    "redis:stop": "node scripts/local-redis.mjs stop",
    "redis:status": "node scripts/local-redis.mjs status",
    "predev": "npm run db:generate && node scripts/local-redis.mjs start",
    "prebuild": "npm run db:generate",
    "pretypecheck": "npm run db:generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nestjs": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.0",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
